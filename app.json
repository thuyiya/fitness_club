{
  "expo": {
    "name": "Nutrition + Fitness",
    "slug": "fitness-club",
    "owner": "glitchfy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nutrition-fitness",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1020"
    },
    "assetBundlePatterns": [
      "assets/**"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.glitchfy.nutritionfitness",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Capture meal and progress photos for your private health journal.",
        "NSPhotoLibraryUsageDescription": "Choose meal and progress photos for your private health journal.",
        "UIFileSharingEnabled": false,
        "NSHealthShareUsageDescription": "Read your steps, active calories, exercise minutes, distance, workouts and weight to show your health progress. Health data stays on your device."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1020"
      },
      "package": "com.glitchfy.nutritionfitness",
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1020",
          "image": "./assets/splash.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "14.0"
          }
        }
      ],
      "expo-notifications",
      "./plugins/withBackgroundDownloader",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your private meal and progress journal.",
          "cameraPermission": "Capture photos for your private meal and progress journal.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "54075fd3-fcf3-4fab-8af4-6aa13ab55449"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/54075fd3-fcf3-4fab-8af4-6aa13ab55449"
    }
  }
}
