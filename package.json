{
  "name": "wellness-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @wellness/db generate",
    "db:migrate": "pnpm --filter @wellness/db migrate",
    "db:studio": "pnpm --filter @wellness/db studio",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "dev:api": "pnpm --filter @wellness/api dev",
    "dev:app": "node scripts/dev.mjs web",
    "db:seed": "pnpm --filter @wellness/db seed",
    "db:embed": "pnpm --filter @wellness/db seed:embed",
    "demo:users": "node scripts/demo-users.mjs",
    "smoke": "node apps/api/smoke.mjs && node apps/api/smoke-domain.mjs && node apps/api/smoke-comms.mjs",
    "dev:ios": "node scripts/dev.mjs ios",
    "dev:android": "node scripts/dev.mjs android",
    "dev:all": "node scripts/dev.mjs",
    "dev:device": "node scripts/dev.mjs device"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}