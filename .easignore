# EAS Build reads .easignore ONLY from the repository root, and when this file exists it replaces
# every .gitignore (root and nested). Keep the .gitignore rules below in sync.
#
# Native folders are excluded on purpose: EAS runs `expo prebuild` and generates ios/ and android/
# from app.json + config plugins. apps/nutrition-fitness/ios is committed for local Xcode builds,
# but uploading it (filtered through .gitignore) produced a partial ios/ with no Podfile, which
# made EAS skip prebuild and fail at "Install pods" (build 977ce8de, Nov 11 2026).

# ---- from .gitignore ----
node_modules/
dist/
.turbo/
*.tsbuildinfo

# env
.env
.env*.local
infra/.env

# expo
.expo/
expo-env.d.ts
*.orig.*
web-build/

# native build output
ios/build/
android/build/
android/app/build/
android/.gradle/

# misc
.DS_Store
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore

# Generated by expo prebuild (continuous native generation)
ios/
android/

# ---- EAS-only: large folders the app never imports ----
apps/nutrition-fitness/exercise-db/
apps/nutrition-fitness/sport-db/
apps/nutrition-fitness/release/
apps/nutrition-fitness/output/
*.ipa
*.aab
*.apk
