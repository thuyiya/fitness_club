{
  "$comment": "Ready-made survey templates a coach can assign (C28 build, C29 assign, C30 analytics, M22 member response). Seeds `surveys` plus `survey_questions`. `type` values match the question_type enum; `repeats` values match the recurrence enum. options is null for short_text, long_text, date and boolean.",
  "items": [
    {
      "id": "survey_weekly_checkin",
      "title": "Weekly check-in",
      "description": "A short pulse on energy, recovery and adherence over the past week.",
      "repeats": "weekly",
      "questions": [
        {
          "position": 0,
          "type": "scale",
          "prompt": "Rate your energy this week",
          "options": { "min": 1, "max": 5, "minLabel": "Drained", "maxLabel": "Great" },
          "required": true
        },
        {
          "position": 1,
          "type": "scale",
          "prompt": "How well did you recover between sessions?",
          "options": { "min": 1, "max": 5, "minLabel": "Very poorly", "maxLabel": "Fully recovered" },
          "required": true
        },
        {
          "position": 2,
          "type": "single_choice",
          "prompt": "How many planned sessions did you complete?",
          "options": { "choices": ["All of them", "Most of them", "About half", "Only one or two", "None"] },
          "required": true
        },
        {
          "position": 3,
          "type": "scale",
          "prompt": "How closely did you follow your nutrition plan?",
          "options": { "min": 1, "max": 5, "minLabel": "Not at all", "maxLabel": "Exactly" },
          "required": true
        },
        {
          "position": 4,
          "type": "multi_choice",
          "prompt": "What got in the way this week?",
          "options": {
            "choices": [
              "Nothing, good week",
              "Work schedule",
              "Family commitments",
              "Travel",
              "Illness",
              "Injury or pain",
              "Low motivation",
              "Poor sleep"
            ]
          },
          "required": false
        },
        {
          "position": 5,
          "type": "long_text",
          "prompt": "Anything you want your coach to know?",
          "options": null,
          "required": false
        }
      ]
    },
    {
      "id": "survey_onboarding_health_history",
      "title": "Health history",
      "description": "Collected once at sign-up so your coach can programme safely.",
      "repeats": "once",
      "questions": [
        {
          "position": 0,
          "type": "date",
          "prompt": "Date of birth",
          "options": null,
          "required": true
        },
        {
          "position": 1,
          "type": "boolean",
          "prompt": "Has a doctor ever told you to avoid certain physical activity?",
          "options": null,
          "required": true
        },
        {
          "position": 2,
          "type": "multi_choice",
          "prompt": "Do any of these apply to you?",
          "options": {
            "choices": [
              "None of these",
              "High blood pressure",
              "Heart condition",
              "Diabetes",
              "Asthma or breathing condition",
              "Joint or back problems",
              "Pregnancy or postpartum",
              "Prefer not to say"
            ]
          },
          "required": true
        },
        {
          "position": 3,
          "type": "long_text",
          "prompt": "List any current or past injuries and when they occurred",
          "options": null,
          "required": false
        },
        {
          "position": 4,
          "type": "long_text",
          "prompt": "List any medications or supplements you take regularly",
          "options": null,
          "required": false
        },
        {
          "position": 5,
          "type": "multi_choice",
          "prompt": "Do you have any dietary requirements?",
          "options": {
            "choices": [
              "None",
              "Vegetarian",
              "Vegan",
              "Halal",
              "Kosher",
              "Gluten free",
              "Dairy free",
              "Nut allergy",
              "Other allergy"
            ]
          },
          "required": true
        },
        {
          "position": 6,
          "type": "single_choice",
          "prompt": "How would you describe your training experience?",
          "options": { "choices": ["Complete beginner", "Returning after a break", "1-2 years", "3-5 years", "5+ years"] },
          "required": true
        },
        {
          "position": 7,
          "type": "single_choice",
          "prompt": "What is your main goal right now?",
          "options": {
            "choices": ["Lose fat", "Build muscle", "Recomposition", "Endurance performance", "General health", "Maintain"]
          },
          "required": true
        }
      ]
    },
    {
      "id": "survey_training_readiness",
      "title": "Daily readiness",
      "description": "A 30-second check before today's session so load can be adjusted.",
      "repeats": "daily",
      "questions": [
        {
          "position": 0,
          "type": "scale",
          "prompt": "How ready do you feel to train today?",
          "options": { "min": 1, "max": 10, "minLabel": "Not at all", "maxLabel": "Fully ready" },
          "required": true
        },
        {
          "position": 1,
          "type": "scale",
          "prompt": "Muscle soreness right now",
