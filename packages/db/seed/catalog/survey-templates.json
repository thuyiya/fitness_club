          "required": true
        },
        {
          "position": 2,
          "type": "scale",
          "prompt": "Stress level today",
          "options": { "min": 1, "max": 5, "minLabel": "Very calm", "maxLabel": "Very stressed" },
          "required": true
        },
        {
          "position": 3,
          "type": "boolean",
          "prompt": "Are you feeling unwell or carrying an illness?",
          "options": null,
          "required": true
        },
        {
          "position": 4,
          "type": "short_text",
          "prompt": "Anything to flag before the session?",
          "options": null,
          "required": false
        }
      ]
    },
    {
      "id": "survey_nutrition_habits",
      "title": "Nutrition habits",
      "description": "A picture of how you currently eat, so the plan fits your life.",
      "repeats": "monthly",
      "questions": [
        {
          "position": 0,
          "type": "single_choice",
          "prompt": "How many meals do you usually eat per day?",
          "options": { "choices": ["1", "2", "3", "4", "5 or more"] },
          "required": true
        },
        {
          "position": 1,
          "type": "single_choice",
          "prompt": "How often do you cook at home?",
          "options": { "choices": ["Almost every meal", "Most meals", "About half", "Rarely", "Almost never"] },
          "required": true
        },
        {
          "position": 2,
          "type": "single_choice",
          "prompt": "How many portions of vegetables do you eat on a typical day?",
          "options": { "choices": ["0", "1", "2", "3", "4", "5 or more"] },
          "required": true
        },
        {
          "position": 3,
          "type": "scale",
          "prompt": "How consistent is your protein intake across the day?",
          "options": { "min": 1, "max": 5, "minLabel": "Very inconsistent", "maxLabel": "Very consistent" },
          "required": true
        },
        {
          "position": 4,
          "type": "multi_choice",
          "prompt": "Which of these do you find hardest?",
          "options": {
            "choices": [
              "Hitting protein",
              "Portion sizes",
              "Evening snacking",
              "Eating enough vegetables",
              "Drinking enough water",
              "Alcohol",
              "Eating out",
              "Meal prep time"
            ]
          },
          "required": false
        },
        {
          "position": 5,
          "type": "single_choice",
          "prompt": "How many alcoholic drinks do you have in a typical week?",
          "options": { "choices": ["None", "1-3", "4-7", "8-14", "More than 14"] },
          "required": false
        },
        {
          "position": 6,
          "type": "long_text",
          "prompt": "Any foods you strongly dislike or want to avoid?",
          "options": null,
          "required": false
        }
      ]
    },
    {
      "id": "survey_sleep_quality",
      "title": "Sleep quality",
      "description": "Sleep drives recovery. This helps spot patterns week to week.",
      "repeats": "weekly",
      "questions": [
        {
          "position": 0,
          "type": "single_choice",
          "prompt": "On average, how many hours did you sleep per night this week?",
          "options": { "choices": ["Under 5", "5-6", "6-7", "7-8", "8-9", "Over 9"] },
          "required": true
        },
        {
          "position": 1,
          "type": "scale",
          "prompt": "How would you rate your sleep quality?",
          "options": { "min": 1, "max": 5, "minLabel": "Very poor", "maxLabel": "Excellent" },
          "required": true
        },
        {
          "position": 2,
          "type": "single_choice",
          "prompt": "How long did it usually take you to fall asleep?",
          "options": { "choices": ["Under 10 minutes", "10-20 minutes", "20-40 minutes", "Over 40 minutes"] },
          "required": true
        },
        {
          "position": 3,
          "type": "single_choice",
          "prompt": "How often did you wake during the night?",
          "options": { "choices": ["Not at all", "Once", "Twice", "Three or more times"] },
          "required": true
        },
        {
          "position": 4,
          "type": "scale",
          "prompt": "How rested did you feel on waking?",
          "options": { "min": 1, "max": 5, "minLabel": "Exhausted", "maxLabel": "Fully refreshed" },
          "required": true
        },
        {
          "position": 5,
          "type": "multi_choice",
          "prompt": "What disrupted your sleep?",
          "options": {
            "choices": [
              "Nothing",
              "Screen time late",
              "Caffeine",
              "Alcohol",
              "Stress or racing thoughts",
              "Noise or light",
              "Children or pets",
              "Shift work",
              "Pain or discomfort"
            ]
          },
          "required": false
        }
      ]
    },
    {
      "id": "survey_motivation_adherence",
      "title": "Motivation and adherence",
      "description": "Where you are with the plan, and what support would help most.",
