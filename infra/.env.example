# Copy to infra/.env and fill in. Never commit infra/.env.

# --- Postgres ---
POSTGRES_USER=wellness
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=wellness

# --- Auth (generate with: openssl rand -hex 48) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Public address ---
# Local dev: :80
# Production: api.yourdomain.com   (Caddy then auto-provisions TLS)
SITE_ADDRESS=:80

# --- Cloudflare R2 (media: progress photos, meal photos) ---
# R2 has zero egress fees, which is the whole reason it is here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wellness-media
