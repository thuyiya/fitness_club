# Caddy terminates TLS (auto Let's Encrypt when SITE_ADDRESS is a real domain)
# and round-robins across however many `api` replicas are running.
{$SITE_ADDRESS} {
	encode zstd gzip

	# WebSocket upgrade for chat must bypass buffering.
	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}

	handle /ws* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy api:3000 {
			# Docker's embedded DNS returns every replica, so this is the
			# load balancer --- no extra component needed.
			lb_policy least_conn
			health_uri /health
			health_interval 10s
			health_timeout 3s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
