{
  "expo": {
    "name": "Wellness 2.0",
    "slug": "wellness-2",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "wellness",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.glitchfy.wellness",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Wellness connects to your development server on this network."
      }
    },
    "android": {
      "package": "com.glitchfy.wellness",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "./plugins/withMinIosDeploymentTarget",
        {
          "deploymentTarget": "15.1"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}